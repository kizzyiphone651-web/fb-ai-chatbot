# พอร์ตสำหรับรัน Webhook Server
PORT=3000

# Meta Facebook Messenger Config
# PAGE_ACCESS_TOKEN ได้จาก Meta for Developers > Messenger > API Setup
PAGE_ACCESS_TOKEN=your_facebook_page_access_token_here

# VERIFY_TOKEN เป็นรหัสลับที่พี่ตั้งเอง เช่น my_secret_verify_token_123 เพื่อใส่ใน Facebook Webhook Verification
VERIFY_TOKEN=my_facebook_webhook_verify_token

# Google Gemini API Key
# รับฟรีได้ที่ https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# โมเดล Gemini ที่ต้องการใช้งาน (แนะนำ gemini-3.5-flash-lite ตอบเร็วทันใจ)
GEMINI_MODEL=gemini-3.5-flash-lite
